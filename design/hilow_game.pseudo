# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidlines and Rubric.

START hilow_game

   # Establish a valid guessing range.
   OUTPUT "Welcome to the Higher/Lower Game!"
   OUTPUT "Enter the lower bound:"
   INPUT lower_bound
   OUTPUT "Enter the upper bound:"
   INPUT upper_bound

WHILE lower_bound >= upper_bound
    OUTPUT "Invalid bounds. The lower bound must be less than the upper bound."
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound
    OUTPUT "Enter the upper bound:"
    INPUT upper_bound
END WHILE

# Establish the number the player is trying to guess.
SET secret_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

# Play the game.
OUTPUT "Guess a number between " + lower_bound + " and " + upper_bound + ":"
INPUT user_guess

WHILE user_guess < lower_bound OR user_guess > upper_bound
    OUTPUT "Out of bounds. Enter a number between " + lower_bound + " and " + upper_bound + ":"
    INPUT user_guess
   END WHILE

   WHILE user_guess != secret_number
       IF user_guess < secret_number THEN
           OUTPUT "Nope, too low."
       ELSE IF user_guess > secret_number THEN
           OUTPUT "Nope, too high."
       END IF

       OUTPUT "Guess a number between " + lower_bound + " and " + ":"
       INPUT user_guess

        WHILE user_guess < lower_bound OR user_guess > upper_bound
            OUTPUT "Out of bounds. Enter a number between " + lower_bound + " and " + upper_bound + ":"
            INPUT user_guess
        END WHILE
    END WHILE

OUTPUT "You got it!"

END hilow_game
